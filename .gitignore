# secrets: never commit keys or env files
.env
.env.*
!.env.example
*.key
*_key
*_key.txt
*apikey*
openrouterkey.txt
# run outputs and caches (re-created by the commands in README.md)
/keys_and_god/runs/
/keys_and_god/cache/
/keys_and_god/legacy_e1/runs/
/keys_and_god/legacy_e1/cache/
/betrayal/runs/v2run/
/betrayal/runs/*_log*.txt
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.hypothesis/
*.egg-info/
