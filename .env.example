# Copy to .env (never commit it) or export these in your shell. Placeholders only.
# Every script reads a key from an env var or from a key FILE whose PATH you give; keys are never printed.

# OpenRouter (Keys & God, betrayal study, CoT judge)
OPENROUTER_API_KEY=your-openrouter-key-here
# ...or keep the key in a file outside the repo and point to it:
OPENROUTER_KEY_FILE=/path/outside/repo/openrouter.key

# Adaption Labs (Responses API: 100-agent sweep, tie-in, stronger-model arms, tempt300 single scenes)
ADAPTION_API_KEY=your-adaption-key-here
ADAPTION_KEY_FILE=/path/outside/repo/adaption.key

# Where each part runs from (defaults to the current directory)
SWARM_ROOT=./keys_and_god
PLANC_ROOT=./betrayal
LFM_ROOT=./single_agent
# Interpreter used by the shell launchers
PY=python
